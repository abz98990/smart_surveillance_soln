# Copy to .env and fill in. .env is git-ignored - never commit real values.

# --- Email alert channel (optional) ---
# Leave SSS_SMTP_USER blank to disable email alerts entirely.
SSS_SMTP_HOST=smtp.gmail.com
SSS_SMTP_PORT=587
SSS_SMTP_USER=
SSS_SMTP_PASSWORD=
SSS_SMTP_FROM=
# Comma-separated list of recipients
SSS_ALERT_RECIPIENTS=

# --- Web dashboard ---
SSS_WEB_HOST=127.0.0.1
SSS_WEB_PORT=8000
